<% content_for :title, "Importar Preguntas" %>

<div class="mb-4">
  <h1 class="h3 fw-bold text-dark">Importar Preguntas</h1>
</div>

<div class="chart-container">
  <p class="text-muted">Total de preguntas en la base de datos: <strong><%= @total_questions %></strong></p>

  <%= form_with url: admin_import_path, method: :post, local: true, multipart: true do |f| %>
    <div class="mb-4">
      <%= f.label :file, "Archivo Excel (.xlsx)", class: "form-label fw-semibold" %>
      <%= f.file_field :file, accept: ".xlsx,.xls", class: "form-control form-control-lg" %>
    </div>

    <%= f.submit "Importar Preguntas", class: "btn btn-primary btn-lg" %>
  <% end %>
</div>
