<% content_for :title, "Dashboard" %>

<div class="mb-4">
  <h1 class="h3 fw-bold text-dark">Dashboard</h1>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="stat-card">
      <div class="stat-value"><%= @total_students %></div>
      <div class="stat-label">Total Estudiantes</div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card">
      <div class="stat-value"><%= @total_attempts %></div>
      <div class="stat-label">Intentos Completados</div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card">
      <div class="stat-value"><%= @avg_percentage %>%</div>
      <div class="stat-label">Promedio General</div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card">
      <div class="stat-value"><%= @recent_7_days %></div>
      <div class="stat-label">Últimos 7 días</div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="chart-container" style="height: 350px;">
      <h5 class="fw-bold mb-3">Score Promedio por Zona</h5>
      <% if @by_zone.any? %>
        <canvas data-controller="chart"
                data-chart-type-value="bar"
                data-chart-data-value="<%= {
                  labels: @by_zone.keys,
                  datasets: [{
                    label: 'Promedio Score',
                    data: @by_zone.values.map { |v| v.round(1) },
                    backgroundColor: 'rgba(0, 180, 216, 0.7)',
                    borderColor: '#00b4d8',
                    borderWidth: 1
                  }]
                }.to_json %>"
                data-chart-options-value="<%= {
                  responsive: true,
                  maintainAspectRatio: false,
                  plugins: { legend: { display: false } },
                  scales: {
                    y: { beginAtZero: true, max: 30, title: { display: true, text: 'Score' } },
                    x: { title: { display: true, text: 'Zona' } }
                  }
                }.to_json %>"></canvas>
      <% else %>
        <div class="d-flex align-items-center justify-content-center h-100 text-muted">
          <p>Sin datos disponibles</p>
        </div>
      <% end %>
    </div>
  </div>
  <div class="col-md-6">
    <div class="chart-container" style="height: 350px;">
      <h5 class="fw-bold mb-3">Distribución de Scores</h5>
      <% if @score_distribution.any? %>
        <canvas data-controller="chart"
                data-chart-type-value="bar"
                data-chart-data-value="<%= {
                  labels: @score_distribution.keys.map { |k| "#{k.to_i}-#{k.to_i + 4}" },
                  datasets: [{
                    label: 'Cantidad',
                    data: @score_distribution.values,
                    backgroundColor: 'rgba(0, 119, 182, 0.7)',
                    borderColor: '#0077b6',
                    borderWidth: 1
                  }]
                }.to_json %>"
                data-chart-options-value="<%= {
                  responsive: true,
                  maintainAspectRatio: false,
                  plugins: { legend: { display: false } },
                  scales: {
                    y: { beginAtZero: true, title: { display: true, text: 'Cantidad' } },
                    x: { title: { display: true, text: 'Rango de Score' } }
                  }
                }.to_json %>"></canvas>
      <% else %>
        <div class="d-flex align-items-center justify-content-center h-100 text-muted">
          <p>Sin datos disponibles</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="chart-container quick-actions">
  <h5 class="fw-bold mb-3">Accesos Rápidos</h5>
  <div class="d-flex gap-3 flex-wrap">
    <%= link_to "Ver Resultados", admin_results_path, class: "btn btn-primary" %>
    <%= link_to "Exportar Excel", admin_results_export_path(format: :xlsx), class: "btn btn-success" %>
    <%= link_to "Importar Preguntas", admin_import_path, class: "btn btn-outline-secondary" %>
  </div>
</div>
