<% content_for :title, "Resultados" %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h1 class="h3 fw-bold text-dark mb-0">Resultados</h1>
  <%= link_to "Exportar Excel", admin_results_export_path(q: params[:q], format: :xlsx), class: "btn btn-success" %>
</div>

<div class="chart-container mb-4">
  <%= search_form_for @q, url: admin_results_path, method: :get, class: "row g-3 align-items-end" do |f| %>
    <div class="col-md-4">
      <%= f.label :attempt_completed_at_gteq, "Desde", class: "form-label fw-semibold" %>
      <%= f.date_field :attempt_completed_at_gteq, value: params.dig(:q, :attempt_completed_at_gteq), class: "form-control" %>
    </div>
    <div class="col-md-4">
      <%= f.label :attempt_completed_at_lteq, "Hasta", class: "form-label fw-semibold" %>
      <%= f.date_field :attempt_completed_at_lteq, value: params.dig(:q, :attempt_completed_at_lteq), class: "form-control" %>
    </div>
    <div class="col-md-4">
      <%= f.submit "Filtrar", class: "btn btn-primary" %>
      <%= link_to "Limpiar", admin_results_path, class: "btn btn-outline-secondary" %>
    </div>
  <% end %>
</div>

<% if @attempts.any? %>
  <div class="chart-container p-0 overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Cédula</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>Zona</th>
            <th>Score</th>
            <th>%</th>
            <th>Fecha</th>
          </tr>
        </thead>
        <tbody>
          <% @attempts.each do |attempt| %>
            <tr>
              <td><%= attempt.student.cedula %></td>
              <td><%= attempt.student.name %></td>
              <td><%= attempt.student.email %></td>
              <td><%= attempt.student.zona %></td>
              <td><%= attempt.score %>/<%= attempt.total_questions %></td>
              <td>
                <% percentage = ((attempt.score.to_f / attempt.total_questions) * 100).round %>
                <span class="badge <%= percentage >= 70 ? 'bg-success' : percentage >= 50 ? 'bg-warning' : 'bg-danger' %>">
                  <%= percentage %>%
                </span>
              </td>
              <td><%= attempt.completed_at&.strftime("%Y-%m-%d %H:%M") || "-" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-3">
    <%= paginate @attempts, theme: 'bootstrap-5' %>
  </div>
<% else %>
  <div class="chart-container text-center py-5">
    <p class="text-muted mb-0">No hay resultados disponibles</p>
  </div>
<% end %>
