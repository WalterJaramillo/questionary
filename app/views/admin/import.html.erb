<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="card mt-5">
      <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
          <h1 class="h2 fw-bold text-primary">Importar Preguntas</h1>
          <p class="text-muted">Sube el archivo Excel con las preguntas del quiz</p>
        </div>

        <% if flash[:notice] %>
          <div class="alert alert-success" role="alert">
            <%= flash[:notice] %>
          </div>
        <% end %>

        <% if flash[:alert] %>
          <div class="alert alert-danger" role="alert">
            <%= flash[:alert] %>
          </div>
        <% end %>

        <div class="mb-3">
          <p class="text-muted small">Total de preguntas en la base de datos: <strong><%= Question.count %></strong></p>
        </div>

        <%= form_with url: admin_import_path, method: :post, local: true, multipart: true do |f| %>
          <div class="mb-4">
            <%= f.label :file, "Archivo Excel (.xlsx)", class: "form-label fw-semibold" %>
            <%= f.file_field :file, accept: ".xlsx,.xls", class: "form-control form-control-lg" %>
          </div>

          <%= f.submit "Importar Preguntas", class: "btn btn-primary btn-lg w-100" %>
        <% end %>

        <div class="mt-4">
          <%= link_to "← Volver al inicio", root_path, class: "btn btn-outline-secondary w-100" %>
        </div>
      </div>
    </div>
  </div>
</div>
