<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6 col-xl-5">
    <div class="text-center mb-3">
      <img src="/uno.jpeg" alt="Evaluación Técnica" class="img-fluid rounded-3 shadow" style="max-height: 180px; object-fit: cover;">
    </div>
    <div class="card mt-4 mt-md-5">
      <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
          <h1 class="h2 fw-bold text-primary">Evaluación Técnica</h1>
          <p class="text-muted">Ingresa tus datos para iniciar la evaluación. Tendrás 20 minutos para responder 30 preguntas. Solo tienes un intento.</p>
        </div>

        <% if flash[:alert] %>
          <div class="alert alert-danger" role="alert">
            <%= flash[:alert] %>
          </div>
        <% end %>

        <%= form_with url: start_quiz_path, method: :post, local: true do |f| %>
          <div class="mb-3">
            <%= f.label :cedula, "Número de identificación", class: "form-label fw-semibold" %>
            <%= f.text_field :cedula, required: true, pattern: "[0-9]*", inputmode: "numeric", class: "form-control form-control-lg", placeholder: "Ingresa tu número de identificación" %>
          </div>

          <div class="mb-3">
            <%= f.label :name, "Nombre completo", class: "form-label fw-semibold" %>
            <%= f.text_field :name, required: true, class: "form-control form-control-lg", placeholder: "Ingresa tu nombre completo" %>
          </div>

          <div class="mb-3">
            <%= f.label :email, "Correo electrónico", class: "form-label fw-semibold" %>
            <%= f.email_field :email, required: true, class: "form-control form-control-lg", placeholder: "ejemplo@correo.com" %>
          </div>

          <div class="mb-4">
            <%= f.label :zona, "Selecciona tu zona", class: "form-label fw-semibold" %>
            <div class="select-wrapper">
              <%= f.select :zona,
                options_for_select([
                  ["Selecciona tu zona", ""],
                  ["── Zona Meta ──", nil, { disabled: true }],
                  *Student::ZONAS["Zona Meta"].map { |z| [z, z] },
                  ["── Otras zonas ──", nil, { disabled: true }],
                  *Student::ZONAS["Otras zonas"].map { |z| [z, z] }
                ]),
                {},
                required: true,
                class: "form-control form-control-lg zona-select"
              %>
            </div>
          </div>

          <div class="policy-box mb-4 p-4 rounded-3 d-flex align-items-start gap-3" style="background: #e7f1ff; border: 2px solid #0d6efd; box-shadow: 0 2px 8px rgba(13, 110, 253, 0.25);">
            <input class="form-check-input mt-1" type="checkbox" id="policy_accepted" name="policy_accepted" value="1" required style="width: 1.4em; height: 1.4em; cursor: pointer;">
            <label class="form-check-label fw-bold" for="policy_accepted" style="font-size: 1.05rem; color: #084298; cursor: pointer; line-height: 1.5;">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-shield-check mb-1 me-1" viewBox="0 0 16 16">
                <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.627c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.627 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.461 62.461 0 0 1 5.072.56z"/>
                <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
              </svg>
              Acepto la política de tratamiento de datos
            </label>
          </div>

          <%= f.submit "Iniciar Evaluación", class: "btn btn-primary btn-lg w-100" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
