<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6 col-xl-5">
    <div class="card mt-4 mt-md-5">
      <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
          <h1 class="h2 fw-bold text-primary">Evaluación Técnica</h1>
          <p class="text-muted">Ingresa tus datos para iniciar la evaluación. Tendrás 20 minutos para responder 30 preguntas. Solo tienes un intento.</p>
        </div>

        <% if flash[:alert] %>
          <div class="alert alert-danger" role="alert">
            <%= flash[:alert] %>
          </div>
        <% end %>

        <%= form_with url: start_quiz_path, method: :post, local: true do |f| %>
          <div class="mb-3">
            <%= f.label :cedula, "Número de identificación", class: "form-label fw-semibold" %>
            <%= f.text_field :cedula, required: true, pattern: "[0-9]*", inputmode: "numeric", class: "form-control form-control-lg", placeholder: "Ingresa tu número de identificación" %>
          </div>

          <div class="mb-3">
            <%= f.label :name, "Nombre completo", class: "form-label fw-semibold" %>
            <%= f.text_field :name, required: true, class: "form-control form-control-lg", placeholder: "Ingresa tu nombre completo" %>
          </div>

          <div class="mb-3">
            <%= f.label :email, "Correo electrónico", class: "form-label fw-semibold" %>
            <%= f.email_field :email, required: true, class: "form-control form-control-lg", placeholder: "ejemplo@correo.com" %>
          </div>

          <div class="mb-4">
            <%= f.label :zona, "Selecciona tu zona", class: "form-label fw-semibold" %>
            <div class="select-wrapper">
              <%= f.select :zona,
                options_for_select([
                  ["Selecciona tu zona", ""],
                  ["── Zona Meta ──", nil, { disabled: true }],
                  *Student::ZONAS["Zona Meta"].map { |z| [z, z] },
                  ["── Otras zonas ──", nil, { disabled: true }],
                  *Student::ZONAS["Otras zonas"].map { |z| [z, z] }
                ]),
                {},
                required: true,
                class: "form-control form-control-lg zona-select"
              %>
            </div>
          </div>

          <%= f.submit "Iniciar Evaluación", class: "btn btn-primary btn-lg w-100" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
