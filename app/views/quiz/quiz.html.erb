<div class="row justify-content-center">
  <div class="col-12 col-lg-10 col-xl-8">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
      <h1 class="h3 fw-bold text-white mb-0">Evaluación Técnica</h1>
      <div class="d-flex gap-2">
        <span class="badge bg-success fs-6 px-3 py-2"><%= @answered.size %>/30 respondidas</span>
        <% unless @show_all_questions %>
          <span class="badge badge-page text-white fs-6 px-3 py-2">Página <%= @page %> de <%= @total_pages %></span>
        <% end %>
      </div>
    </div>

    <div class="timer-bar mb-3" data-controller="countdown" data-countdown-seconds-value="<%= @time_remaining %>">
      <div class="d-flex justify-content-between align-items-center p-3 rounded" style="background: rgba(255,255,255,0.1); backdrop-filter: blur(4px);">
        <span class="fw-bold text-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-clock me-1" viewBox="0 0 16 16">
            <path d="M8 3.5a.5.5 0 0 0-1 0V8a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 7.71V3.5z"/>
            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
          </svg>
          Tiempo restante:
        </span>
        <span class="timer-display fs-4 fw-bold font-monospace" data-countdown-target="display"><%= @time_remaining_formatted %></span>
      </div>
    </div>

    <% if @show_all_questions %>
      <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-exclamation-triangle-fill me-2 flex-shrink-0" viewBox="0 0 16 16">
          <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
        </svg>
        <div>
          <strong>¡Quedan menos de 5 minutos!</strong> Se muestran todas las preguntas restantes para que puedas responderlas rápidamente.
        </div>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div class="alert alert-danger" role="alert">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <div class="progress mb-4" style="height: 8px;">
      <div class="progress-bar" role="progressbar" style="width: <%= (@answered.size.to_f / 30) * 100 %>%"></div>
    </div>

    <%= form_with url: submit_quiz_path, method: :post, local: true, id: "quiz-form" do |f| %>
      <% @questions.each_with_index do |question, index| %>
        <div class="card question-card mb-3">
          <div class="card-body p-3 p-md-4">
            <h5 class="card-title fw-semibold mb-3">
              <span class="badge bg-primary me-2"><%= (@page - 1) * @questions_per_page + index + 1 %></span>
              <%= question.question_text %>
            </h5>

            <div class="list-group list-group-flush">
              <% [["a", question.option_a], ["b", question.option_b], ["c", question.option_c], ["d", question.option_d]].each do |letter, text| %>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="answers[<%= question.id %>]" id="q<%= question.id %>_<%= letter %>" value="<%= letter %>" <%= @answered[question.id.to_s] == letter ? 'checked' : '' %> required>
                  <label class="form-check-label" for="q<%= question.id %>_<%= letter %>">
                    <strong><%= letter.upcase %>.</strong> <%= text.sub(/\A[a-d]\.\s*/i, '') %>
                  </label>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <% @answered.each do |q_id, answer| %>
        <input type="hidden" name="answers[<%= q_id %>]" value="<%= answer %>">
      <% end %>

      <div class="d-flex justify-content-between mb-5">
        <% if @show_all_questions %>
          <div></div>
          <%= f.submit "Enviar Respuestas", class: "btn btn-success btn-lg" %>
        <% else %>
          <% if @page > 1 %>
            <%= link_to "← Anterior", quiz_path(page: @page - 1), class: "btn btn-outline-light" %>
          <% else %>
            <div></div>
          <% end %>

          <% if @page < @total_pages %>
            <button type="submit" name="next_page" value="<%= @page + 1 %>" class="btn btn-primary">
              Siguiente →
            </button>
          <% else %>
            <%= f.submit "Enviar Respuestas", class: "btn btn-success btn-lg" %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
