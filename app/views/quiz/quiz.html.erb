<div class="row justify-content-center">
  <div class="col-12 col-lg-10 col-xl-8">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
      <h1 class="h3 fw-bold text-white mb-0">Evaluación Técnica</h1>
      <div class="d-flex gap-2">
        <span class="badge bg-success fs-6 px-3 py-2"><%= @answered.size %>/30 respondidas</span>
        <span class="badge badge-page text-white fs-6 px-3 py-2">Página <%= @page %> de <%= @total_pages %></span>
      </div>
    </div>

    <% if flash[:alert] %>
      <div class="alert alert-danger" role="alert">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <div class="progress mb-4" style="height: 8px;">
      <div class="progress-bar" role="progressbar" style="width: <%= (@answered.size.to_f / 30) * 100 %>%"></div>
    </div>

    <%= form_with url: submit_quiz_path, method: :post, local: true do |f| %>
      <% @questions.each_with_index do |question, index| %>
        <div class="card question-card mb-3">
          <div class="card-body p-3 p-md-4">
            <h5 class="card-title fw-semibold mb-3">
              <span class="badge bg-primary me-2"><%= (@page - 1) * 5 + index + 1 %></span>
              <%= question.question_text %>
            </h5>

            <div class="list-group list-group-flush">
              <% [["a", question.option_a], ["b", question.option_b], ["c", question.option_c], ["d", question.option_d]].each do |letter, text| %>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="answers[<%= question.id %>]" id="q<%= question.id %>_<%= letter %>" value="<%= letter %>" <%= @answered[question.id.to_s] == letter ? 'checked' : '' %> required>
                  <label class="form-check-label" for="q<%= question.id %>_<%= letter %>">
                    <strong><%= letter.upcase %>.</strong> <%= text %>
                  </label>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <% @answered.each do |q_id, answer| %>
        <input type="hidden" name="answers[<%= q_id %>]" value="<%= answer %>">
      <% end %>

      <div class="d-flex justify-content-between mb-5">
        <% if @page > 1 %>
          <%= link_to "← Anterior", quiz_path(page: @page - 1), class: "btn btn-outline-light" %>
        <% else %>
          <div></div>
        <% end %>

        <% if @page < @total_pages %>
          <button type="submit" name="next_page" value="<%= @page + 1 %>" class="btn btn-primary">
            Siguiente →
          </button>
        <% else %>
          <%= f.submit "Enviar Respuestas", class: "btn btn-success btn-lg" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
