<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6 col-xl-5">
    <div class="card mt-4 mt-md-5">
      <div class="card-body p-4 p-md-5 text-center">
        <h1 class="h2 fw-bold mb-4">Resultados</h1>

        <% percentage = ((@attempt.score.to_f / @attempt.total_questions) * 100).round %>
        <% score_class = percentage >= 70 ? 'success' : percentage >= 50 ? 'warning' : 'danger' %>

        <div class="score-circle <%= score_class %> text-white mb-4">
          <span class="fs-1 fw-bold"><%= @attempt.score %></span>
          <span class="fs-6">de <%= @attempt.total_questions %></span>
        </div>

        <h2 class="h4 fw-bold mb-2"><%= percentage %>%</h2>
        <p class="text-muted mb-4">
          <%= percentage >= 70 ? '¡Excelente trabajo!' : percentage >= 50 ? 'Buen esfuerzo, puedes mejorar.' : 'Necesitas repasar los temas.' %>
        </p>

        <% if @weak_topics.any? %>
          <hr>
          <div class="text-start">
            <h3 class="h5 fw-bold text-danger mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-exclamation-triangle-fill me-1" viewBox="0 0 16 16">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
              </svg>
              Temas a reforzar
            </h3>
            <ul class="list-unstyled mb-0">
              <% @weak_topics.each do |tema, _| %>
                <% next if tema.blank? %>
                <li class="mb-2 p-2 rounded" style="background: rgba(220, 53, 69, 0.08);">
                  <strong>Debes reforzar más este tema:</strong> <%= tema %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <hr>

        <div class="text-start">
          <p class="mb-1"><strong>Estudiante:</strong> <%= @student.name %></p>
          <p class="mb-1"><strong>Cédula:</strong> <%= @student.cedula %></p>
          <p class="mb-1"><strong>Zona:</strong> <%= @student.zona %></p>
          <p class="mb-1"><strong>Correo:</strong> <%= @student.email %></p>
        </div>

        <hr>
        <p class="text-muted mb-0">Has completado tu único intento disponible.</p>
      </div>
    </div>
  </div>
</div>
