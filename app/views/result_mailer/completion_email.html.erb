<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; padding: 20px; background: #f5f5f5; }
      .container { max-width: 500px; margin: 0 auto; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
      .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 24px; text-align: center; color: #fff; }
      .score { font-size: 48px; font-weight: 700; margin: 0; }
      .percentage { font-size: 18px; margin: 4px 0 0 0; opacity: 0.9; }
      .body { padding: 24px; }
      table { width: 100%; border-collapse: collapse; }
      td { padding: 12px 8px; border-bottom: 1px solid #eee; }
      td:first-child { font-weight: 600; color: #666; width: 40%; }
      .footer { text-align: center; padding: 16px; color: #999; font-size: 12px; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <p class="score"><%= @attempt.score %>/<%= @attempt.total_questions %></p>
        <p class="percentage"><%= ((@attempt.score.to_f / @attempt.total_questions) * 100).round %>% correctas</p>
      </div>

      <div class="body">
        <table>
          <tr><td>Nombre</td><td><%= @student.name %></td></tr>
          <tr><td>Cédula</td><td><%= @student.cedula %></td></tr>
          <tr><td>Zona</td><td><%= @student.zona %></td></tr>
          <tr><td>Correo</td><td><%= @student.email %></td></tr>
          <tr><td>Intento</td><td><%= @student.attempts_count %> de <%= Student::MAX_ATTEMPTS %></td></tr>
          <tr><td>Fecha</td><td><%= @attempt.completed_at.strftime("%d/%m/%Y %H:%M") %></td></tr>
        </table>
      </div>

      <div class="footer">
        Evaluación Técnica — Questionary
      </div>
    </div>
  </body>
</html>
